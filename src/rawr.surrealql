-- Table: Git repositories
DEFINE TABLE IF NOT EXISTS repository SCHEMAFULL
    COMMENT "Git repository containing inspected source code";
DEFINE FIELD IF NOT EXISTS id ON repository TYPE string
    ASSERT $value = string::slug($value)
    COMMENT "Repository slug, matching string::slug";
DEFINE FIELD IF NOT EXISTS repo_url ON repository TYPE string
    ASSERT string::is_url($value);


-- Table: Repo revisions and topology
DEFINE TABLE IF NOT EXISTS revision SCHEMAFULL
    COMMENT "Git commits within a repository";
DEFINE FIELD IF NOT EXISTS id ON revision TYPE array
    ASSERT
        array::len($value) = 2
        AND type::is_record($value[0], "repository")
        AND type::is_string($value[1]);
DEFINE FIELD IF NOT EXISTS repo ON revision TYPE record<repository>
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS sha ON revision
    TYPE string
    VALUE string::lowercase($value)
    ASSERT string::matches($value, "^([0-9a-f]{40}|[0-9a-f]{64})$");
DEFINE FIELD IF NOT EXISTS parents ON revision TYPE array<record<revision>>
    REFERENCE ON DELETE UNSET
    ASSERT record::exists($value);


-- Repo heads
DEFINE TABLE IF NOT EXISTS head SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS id on head TYPE array
    ASSERT
        array::len($value) = 2
        AND type::is_record($value[0], "repository")
        AND type::is_string($value[1]);
DEFINE FIELD IF NOT EXISTS repo ON head TYPE record<repository>
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS name ON head TYPE string
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS rev ON head TYPE record<revision>
    ASSERT $value != NONE AND $value.* != NONE;
DEFINE INDEX IF NOT EXISTS UQ_head_repo_name ON head FIELDS repo, name UNIQUE;


-- Semantic entities, partial tree-sitter objects
DEFINE TABLE IF NOT EXISTS semantic_entity SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS id ON semantic_entity TYPE array
    ASSERT
        array::len($value) = 3
        AND type::is_record($value[0], "repository")
        AND type::is_record($value[1], "revision")
        AND type::is_string($value[2]);

DEFINE FIELD IF NOT EXISTS repo ON semantic_entity TYPE record<repository>
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS rev ON semantic_entity TYPE record<revision>
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS entity_id ON semantic_entity
    TYPE string
    ASSERT string::len() > 0;

DEFINE FIELD IF NOT EXISTS file_path ON semantic_entity TYPE string;
DEFINE FIELD IF NOT EXISTS entity_type ON semantic_entity TYPE string;
DEFINE FIELD IF NOT EXISTS name ON semantic_entity TYPE string;
DEFINE FIELD IF NOT EXISTS parent_id ON semantic_entity TYPE option<record<semantic_entity>>;
-- Deduplicate content on hash. It's likely not needed in this context,
-- and can be retrieved from the repository.
-- DEFINE FIELD IF NOT EXISTS content ON semantic_entity TYPE option<string>;
DEFINE FIELD IF NOT EXISTS content_hash ON semantic_entity TYPE string;
DEFINE FIELD IF NOT EXISTS structural_hash ON semantic_entity TYPE option<string>;

DEFINE FIELD IF NOT EXISTS start_line ON semantic_entity
    TYPE int ASSERT $value >= 0;

DEFINE FIELD IF NOT EXISTS end_line ON semantic_entity
    TYPE int ASSERT $value >= 0 AND $value >= start_line;

DEFINE FIELD IF NOT EXISTS metadata ON semantic_entity TYPE option<object>;


-- Deduplicated content of semantic entities
DEFINE TABLE IF NOT EXISTS semantic_entity_content SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS id ON semantic_entity_content TYPE array
    ASSERT
        array::len($value) = 2
        AND type::is_record($value[0])
        AND type::is_string($value[1]);
DEFINE FIELD IF NOT EXISTS repo ON semantic_entity_content TYPE record<repository>
    REFERENCE ON DELETE CASCADE
    ASSERT record::exists($value);
DEFINE FIELD IF NOT EXISTS content_hash ON semantic_entity_content TYPE string;
DEFINE FIELD IF NOT EXISTS content ON semantic_entity_content TYPE string;

DEFINE INDEX IF NOT EXISTS IX_semantic_entity_repo_hash
    ON semantic_entity_content FIELDS repo, content_hash UNIQUE;
